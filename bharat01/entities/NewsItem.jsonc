{
  "name": "NewsItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "breaking",
        "election",
        "politics",
        "development",
        "economy",
        "opinion_poll",
        "tv99"
      ]
    },
    "related_election_id": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "related_type": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "TV99 Ratnagiri"
    }
  },
  "required": [
    "title",
    "content",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}