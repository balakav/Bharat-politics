{
  "name": "Bill",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "state",
        "national"
      ]
    },
    "state_id": {
      "type": "string"
    },
    "proposed_by_id": {
      "type": "string"
    },
    "proposed_by_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "financial_impact": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "speaker_review",
        "speaker_rejected",
        "speaker_office",
        "assembly_vote",
        "assembly_passed",
        "assembly_rejected",
        "rajya_vote",
        "rajya_passed",
        "rajya_rejected",
        "governor_review",
        "governor_approved",
        "governor_rejected",
        "president_review",
        "president_approved",
        "president_rejected",
        "president_returned",
        "law",
        "withdrawn"
      ],
      "default": "draft"
    },
    "assembly_votes_for": {
      "type": "number",
      "default": 0
    },
    "assembly_votes_against": {
      "type": "number",
      "default": 0
    },
    "governor_note": {
      "type": "string"
    },
    "president_note": {
      "type": "string"
    },
    "law_id": {
      "type": "string"
    },
    "introduced_game_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "scope"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}