{
  "name": "PlayerProfile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "e_coins": {
      "type": "number",
      "default": 1000000000
    },
    "party_id": {
      "type": "string"
    },
    "party_name": {
      "type": "string"
    },
    "position_held": {
      "type": "string",
      "default": "None"
    },
    "home_state_id": {
      "type": "string"
    },
    "elections_contested": {
      "type": "number",
      "default": 0
    },
    "elections_won": {
      "type": "number",
      "default": 0
    },
    "reputation": {
      "type": "number",
      "default": 50
    },
    "properties_owned": {
      "type": "number",
      "default": 1
    },
    "vehicles_owned": {
      "type": "number",
      "default": 1
    },
    "net_worth": {
      "type": "number",
      "default": 1000000000
    },
    "friends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_salary_collected": {
      "type": "string",
      "format": "date-time"
    },
    "last_rent_collected": {
      "type": "string",
      "format": "date-time"
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_players": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "salary_multiplier": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}