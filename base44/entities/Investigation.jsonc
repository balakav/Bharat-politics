{
  "name": "Investigation",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "target_player_id": {
      "type": "string"
    },
    "target_player_name": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "state",
        "national"
      ],
      "default": "national"
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "suspicious_assets": {
      "type": "string"
    },
    "estimated_amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_investigation",
        "proven",
        "dismissed",
        "closed"
      ],
      "default": "open"
    },
    "outcome": {
      "type": "string"
    },
    "opened_game_time": {
      "type": "string",
      "format": "date-time"
    },
    "closed_game_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "target_player_id",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}