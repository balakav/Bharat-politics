{
  "name": "Property",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "house",
        "flat",
        "villa",
        "bungalow",
        "shop",
        "office",
        "hotel",
        "factory",
        "farm",
        "land"
      ]
    },
    "location": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "market_value": {
      "type": "number"
    },
    "rental_income": {
      "type": "number"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "for_sale": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "market_value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}