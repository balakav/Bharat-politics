{
  "name": "SupportRequest",
  "type": "object",
  "properties": {
    "formation_request_id": {
      "type": "string"
    },
    "election_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "state",
        "national"
      ]
    },
    "state_id": {
      "type": "string"
    },
    "state_name": {
      "type": "string"
    },
    "from_party_id": {
      "type": "string"
    },
    "from_party_name": {
      "type": "string"
    },
    "to_party_id": {
      "type": "string"
    },
    "to_party_name": {
      "type": "string"
    },
    "to_president_id": {
      "type": "string"
    },
    "seats": {
      "type": "number",
      "default": 0
    },
    "support_type": {
      "type": "string",
      "enum": [
        "coalition",
        "outside_support"
      ],
      "default": "coalition"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "withdrawn"
      ],
      "default": "pending"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "formation_request_id",
    "from_party_name",
    "to_party_id",
    "to_party_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}