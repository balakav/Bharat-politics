{
  "name": "Ministry",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "state",
        "national"
      ]
    },
    "state_id": {
      "type": "string"
    },
    "government_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "head_name": {
      "type": "string"
    },
    "party_name": {
      "type": "string"
    },
    "works": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "scope",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}