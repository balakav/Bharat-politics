{
  "name": "StateSeatConfig",
  "type": "object",
  "properties": {
    "config_type": {
      "type": "string",
      "enum": [
        "state",
        "national"
      ]
    },
    "state_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "assembly_seats": {
      "type": "number"
    },
    "assembly_majority": {
      "type": "number"
    },
    "lok_sabha_seats": {
      "type": "number"
    },
    "lok_sabha_total": {
      "type": "number"
    },
    "lok_sabha_majority": {
      "type": "number"
    }
  },
  "required": [
    "config_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}